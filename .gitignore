# Environment / secrets
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# macOS
.DS_Store

# IDE
.vscode/
.idea/

# Terraform — state files contain resource IDs and must never be committed
# Secret values could appear in state if managed incorrectly
.terraform/
.terraform.lock.hcl
terraform.tfstate
terraform.tfstate.backup
*.tfstate
*.tfstate.*
# local override files — machine-specific, not shared
terraform.tfvars
*.auto.tfvars

